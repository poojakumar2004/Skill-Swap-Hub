# MongoDB connection (Atlas or local)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/skillswap?retryWrites=true&w=majority

# Server
PORT=5000

# JWT signing secret (use a long random string in production)
JWT_SECRET=change_me_to_a_long_random_string

# Optional: browser origin for CORS (e.g. http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

# Optional: Daily.co video calling (rooms work without API key, but API key enables room management)
DAILY_DOMAIN=skillswap-hq
DAILY_API_KEY=
